# Copy to .env and fill in. docker-compose reads this file.
DB_URL=jdbc:postgresql://postgres:5432/fuelnet
DB_USERNAME=fuelnet
DB_PASSWORD=fuelnet

# Must be >= 32 bytes. Generate one: openssl rand -base64 48
JWT_SECRET=change-me-fuelnet-dev-secret-key-must-be-32-bytes-min
JWT_EXPIRATION_MS=86400000

# Comma-separated list of frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# First admin account created on an empty database
SEED_ADMIN_EMAIL=admin@fuelnet.com
SEED_ADMIN_PASSWORD=admin123
