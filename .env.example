# Copy to .env and fill in. docker-compose reads this file.
DB_URL=jdbc:postgresql://postgres:5432/fuelnet
DB_USERNAME=fuelnet
DB_PASSWORD=fuelnet

# Must be >= 32 bytes. Generate one: openssl rand -base64 48
JWT_SECRET=change-me-fuelnet-dev-secret-key-must-be-32-bytes-min
JWT_EXPIRATION_MS=86400000

# Comma-separated list of frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# First admin account created on an empty database
SEED_ADMIN_EMAIL=admin@fuelnet.com
SEED_ADMIN_PASSWORD=admin123

# Public site URL (used in unsubscribe links inside alert emails)
PUBLIC_BASE_URL=http://localhost:5173

# --- Price alert email delivery (optional) ---
# Leave SPRING_MAIL_HOST unset and alerts are written to the application log instead.
# Example for Mailtrap / Gmail SMTP:
# SPRING_MAIL_HOST=sandbox.smtp.mailtrap.io
# SPRING_MAIL_PORT=2525
# SPRING_MAIL_USERNAME=...
# SPRING_MAIL_PASSWORD=...
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_FROM=alerts@fuelnet.com
# ALERT_SWEEP_MS=900000
